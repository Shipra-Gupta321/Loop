# Required for live AI features (classification, Ask LOOP, report narrative).
# Without this, LOOP runs fully functional in "demo mode" with rule-based
# fallbacks — safe to deploy on Vercel with zero configuration.
ANTHROPIC_API_KEY=

# Only needed once you wire up the Prisma schema in prisma/schema.prisma
# to a real Postgres database (Supabase or Neon both work, and both
# support the pgvector extension used by the Embedding model).
DATABASE_URL=
