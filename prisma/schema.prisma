// Prisma schema for Project LOOP.
// NOTE: The deployed demo runs on in-memory mock data (src/lib/mock-data.ts)
// so it works on Vercel with zero setup. Wire this schema up to a real
// Postgres database (Supabase or Neon) when you're ready — see README.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum FeedbackSource {
  EMAIL
  SURVEY
  APP_REVIEW
  SUPPORT_TICKET
  SALES_CALL
  MANUAL
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("Starter")
  createdAt DateTime @default(now())

  users     User[]
  feedback  Feedback[]
  themes    Theme[]
  reports   Report[]
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  role        Role     @default(VIEWER)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime @default(now())
}

model Feedback {
  id          String         @id @default(cuid())
  text        String
  customer    String
  company     String
  source      FeedbackSource @default(MANUAL)
  sentiment   Sentiment
  priority    String         @default("Medium")
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime       @default(now())

  themes      FeedbackTheme[]
  embedding   Embedding?
}

model Theme {
  id          String   @id @default(cuid())
  name        String
  description String
  color       String   @default("#3B5BFF")
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime @default(now())

  feedback    FeedbackTheme[]
}

// Explicit join model (rather than an implicit m2m) so classification
// confidence can be stored per feedback-theme pairing.
model FeedbackTheme {
  feedbackId String
  themeId    String
  confidence Float    @default(1.0)
  feedback   Feedback @relation(fields: [feedbackId], references: [id])
  theme      Theme    @relation(fields: [themeId], references: [id])

  @@id([feedbackId, themeId])
}

// pgvector-backed embedding for RAG retrieval. Requires the pgvector
// extension enabled on the Postgres instance (Supabase/Neon both support it).
model Embedding {
  id         String   @id @default(cuid())
  feedbackId String   @unique
  feedback   Feedback @relation(fields: [feedbackId], references: [id])
  vector     Unsupported("vector(1536)")
  createdAt  DateTime @default(now())
}

model Report {
  id          String   @id @default(cuid())
  title       String
  period      String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  statsJson   Json
  narrativeJson Json
  generatedAt DateTime @default(now())
}
